# Use a separate staging project until live acceptance tests pass.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLIC_PROJECT_KEY
# Exact origins, comma separated. The Vercel-generated VERCEL_URL is also accepted.
APP_ALLOWED_ORIGINS=https://mashrooth.com
# Hosting and AI processing locations are verified through provider contracts and
# deployment records before any public or customer-facing location claim.
# External AI is opt-in. The operator must approve contract-data processing.
AI_ENABLED=false
AI_DATA_PROCESSING_APPROVED=false
AI_MODEL=
ANTHROPIC_API_KEY=
# No service-role key is used in runtime API traffic.

# Paid trial / server billing. Use Stripe TEST credentials for acceptance testing.
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_ENTERPRISE=
NEXT_PUBLIC_SITE_URL=https://YOUR_DEPLOYMENT
